{
  "name": "chinguya-web",
  "private": true,
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:customer": "turbo run dev --filter @chinguya/customer",
    "dev:admin": "turbo run dev --filter @chinguya/admin",
    "dev:mock": "turbo run dev:mock --filter @chinguya/admin",
    "dev:agency": "turbo run dev --filter @chinguya/agency",
    "wireframe": "http-server -p 3003 -c-1 -o /chinguya-wireframes/",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "http-server": "^14.1.1"
  }
}
