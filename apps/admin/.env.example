# 관리자 Core API 주소. BFF(Route Handler)가 서버사이드에서만 쓰므로 NEXT_PUBLIC_ 을 붙이지 않는다
# — Core 주소를 클라이언트 번들에 노출하지 않기 위해서다.
#
# 고객 앱의 NEXT_PUBLIC_API_BASE_URL 과 달리 `/v1` 프리픽스가 없다
# (관리자 컨트롤러는 @RequestMapping("/admin/auth")). 그대로 복사하지 말 것.
ADMIN_CORE_API_BASE_URL=http://localhost:8080

# 퍼블 작업용 로컬 전용 스위치 — Core API 없이 로그인 화면을 통과하고 싶을 때 apps/admin/.env.local
# 에 ADMIN_MOCK_AUTH=true 로 넣는다(.env.local은 커밋되지 않으니 이 예시 파일에는 값을 넣지 않는다).
# ADMIN_MOCK_AUTH=true
