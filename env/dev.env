# EC2 i-0141669a6b9940a5a (ap-northeast-2). systemd `chinguya-api-dev.service` 로 상주한다.
# ⚠ 이 인스턴스에는 Elastic IP가 없다 → stop/start 하면 퍼블릭 IP가 바뀌므로 이 줄도 갱신해야 한다.
APP_ENV=dev
CORE_API_BASE_URL=http://54.180.29.89:8080
